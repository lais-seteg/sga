# ===== Segredos e ambiente =====
# Nada de credencial versionada. As chaves do projeto ficam em .env, que
# nasce a partir de .env.example.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ===== Pasta de segredos =====
# secrets/ guarda material sensivel que NUNCA pode entrar no git: a lista de
# e-mails e senhas iniciais lida por scripts/seed-usuarios.js, dumps de
# usuario, chaves rotacionadas. So o README explicativo e versionado.
secrets/*
!secrets/README.md

# ===== Node e build =====
node_modules/
.next/
out/
dist/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
tsconfig.tsbuildinfo
next-env.d.ts

# ===== Vercel =====
.vercel

# ===== Banco e backup =====
# Nunca subir dump de banco nem copia de seguranca.
bd/
backup/
export-dados.json

# ===== Ferramentas e editores =====
# O settings.local.json guarda preferencias de maquina, nao do projeto.
.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo

# ===== Sistema operacional =====
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# ===== Temporarios e backups =====
# ~$arquivo.docx e o bloqueio que o Word cria ao abrir os documentos de doc/.
~$*
*.bak
*.tmp
*.old
*~
_probe.html
