# ===== Segredos e ambiente =====
# Nada de credencial versionada. As chaves do projeto ficam em
# frontend/.env, que nasce a partir de frontend/.env.example.
.env
.env.*
!.env.example
config.local.js
*.pem
*.key
secrets.json

# ===== Node e build =====
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# ===== Vercel =====
.vercel

# ===== Banco e backup =====
# Nunca subir dump de banco nem cópia de segurança.
bd/
backup/

# ===== Ferramentas e editores =====
# O settings.local.json guarda preferências de máquina, não do projeto.
.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo

# ===== Sistema operacional =====
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# ===== Temporários e backups =====
# ~$arquivo.docx é o bloqueio que o Word cria ao abrir os documentos de doc/.
~$*
*.bak
*.tmp
*.old
*~
_probe.html
